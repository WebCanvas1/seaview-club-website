{
  "name": "seaview-club-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seaview-club-db",
      "database_id": "7987b2ad-2b92-4f40-8fb7-1a29b10d218b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "seaview-club-images"
    }
  ]
}
